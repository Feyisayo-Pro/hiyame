{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/video-intro.ts": {
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/**"
    }
  },
  "rewrites": [
    {
      "source": "/employer-review/:token",
      "destination": "/employer-review/%5Btoken%5D"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
