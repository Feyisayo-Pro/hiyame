EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Smile ID (lib/smileId.ts) — copy these fields out of the smile_config.json
# Smile ID gives you on their dashboard. Never commit that json file itself.
EXPO_PUBLIC_SMILE_PARTNER_ID=your-partner-id
EXPO_PUBLIC_SMILE_AUTH_TOKEN=your-auth-token
EXPO_PUBLIC_SMILE_PROD_URL=https://your-prod-lambda-url.com
EXPO_PUBLIC_SMILE_TEST_URL=https://your-test-lambda-url.com
# "production" uses the prod endpoint; anything else (or unset) uses sandbox.
EXPO_PUBLIC_SMILE_ENV=sandbox

# Sentry (lib/sentry.ts) — Dashboard > Settings > Client Keys (DSN) on
# sentry.io. Crash/performance monitoring is a documented no-op until this
# is set; no other code changes needed once it is.
EXPO_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

# Web Push (lib/webPush.ts) — the web-app equivalent of the architecture
# doc's Expo push service (which is native-only and doesn't apply to a web
# deploy). Public key only; the matching VAPID_PRIVATE_KEY is server-only
# (Vercel env var, never committed, never prefixed EXPO_PUBLIC_).
EXPO_PUBLIC_VAPID_PUBLIC_KEY=generate-with-web-push-generate-vapid-keys
