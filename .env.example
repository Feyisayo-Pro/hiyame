EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Smile ID (lib/smileId.ts) — copy these fields out of the smile_config.json
# Smile ID gives you on their dashboard. Never commit that json file itself.
EXPO_PUBLIC_SMILE_PARTNER_ID=your-partner-id
EXPO_PUBLIC_SMILE_AUTH_TOKEN=your-auth-token
EXPO_PUBLIC_SMILE_PROD_URL=https://your-prod-lambda-url.com
EXPO_PUBLIC_SMILE_TEST_URL=https://your-test-lambda-url.com
# "production" uses the prod endpoint; anything else (or unset) uses sandbox.
EXPO_PUBLIC_SMILE_ENV=sandbox
